# Static assets with content-hash filenames — cache indefinitely
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted font files — cache indefinitely
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache for 30 days (covers may be regenerated)
/images/*
  Cache-Control: public, max-age=2592000

# Favicons and icons — cache for 30 days
/favicon.*
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
