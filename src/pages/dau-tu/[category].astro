---
import { getCollection } from "astro:content";
import CategoryListing from "@/components/CategoryListing.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categories, getArticlePath, getCategoryPath, url } from "@/data/site";
import { buildCollectionPageNodes } from "@/lib/schema";

export async function getStaticPaths() {
  return categories
    .filter((category) => category.group === "Đầu tư")
    .map((category) => ({
      params: { category: category.slug },
      props: { category },
    }));
}

const { category } = Astro.props;
const articles = (await getCollection("articles"))
  .filter((article) => article.data.category === category.slug)
  .sort((a, b) => a.data.order - b.data.order);

const categoryUrl = new URL(getCategoryPath(category), Astro.site).toString();

const breadcrumbItems = [
  { label: "Trang chủ", href: "/" },
  { label: "Đầu tư", href: "/dau-tu/" },
  { label: category.title },
];

const siteUrl = Astro.site?.toString() ?? "";

const schemaNodes = buildCollectionPageNodes({
  siteUrl,
  pageUrl: categoryUrl,
  title: category.title,
  description: category.description,
  breadcrumb: [
    { name: "Trang chủ", item: siteUrl },
    { name: "Đầu tư", item: new URL(url("/dau-tu/"), Astro.site).toString() },
    { name: category.title, item: categoryUrl },
  ],
  items: articles.map((article) => ({
    name: article.data.title,
    url: new URL(getArticlePath(article), Astro.site).toString(),
  })),
});
---

<BaseLayout title={category.title} description={category.description} schemaNodes={schemaNodes}>
  <CategoryListing category={category} articles={articles} breadcrumbItems={breadcrumbItems} />
</BaseLayout>
